{
  "name": "@takt/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma Client 8 pour TAKT — schéma et migrations de la base de données",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify": "prisma db verify",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^7.0.0",
    "typescript": "5.5.x"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "prisma/seed.ts"
  }
}