{
  "name": "@takt/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate --schema prisma/contract.prisma",
    "db:push": "prisma db push --schema prisma/contract.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/contract.prisma"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "argon2": "0.41.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  }
}
