// ============================================================================
// TAKT — Modèle de données (MLD/MDP)
// Fichier : packages/db/prisma/contract.prisma
// Étape E0.5 — Conforme à docs/ST_TAKT.md §2
// Générateur : Prisma Client (@takt/db)
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// 1. Utilisateur — Comptes applicatifs (admin, gest, rdep, dir)
// ----------------------------------------------------------------------------
model Utilisateur {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  nom            String
  prenom         String
  roleId         String   @db.Uuid
  departementId  String?  @db.Uuid
  estActif       Boolean   @default(true)
  motDePasseHash String?    // hash Argon2id du mot de passe (nullable : comptes externes/SSO)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  role             Role                @relation(fields: [roleId], references: [id])
  departement      Departement?        @relation(fields: [departementId], references: [id])
  sessionsRefresh  SessionRefresh[]    // familles de jetons de rafraîchissement (rotation)
  verrous          VerrouSeance[]
  journalAudit     JournalAudit[]
  notifications    Notification[]      // notifications in-app (TAKT-L05-05)

  @@index([email])
  @@index([roleId])
  @@index([departementId])
}

// ----------------------------------------------------------------------------
// 2. Role — Référentiel des rôles (admin, gest, rdep, dir)
// ----------------------------------------------------------------------------
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // admin, gest, rdep, dir
  libelle   String
  utilisateurs Utilisateur[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 3. Etablissement — Référentiel des établissements
// ----------------------------------------------------------------------------
model Etablissement {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  departements Departement[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 4. Departement — Référentiel des départements
// ----------------------------------------------------------------------------
model Departement {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  libelle         String
  etablissementId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])
  utilisateurs    Utilisateur[]
  affectations    AffectationPedagogique[]
  parcours        Parcours[]
  planEtudes      PlanEtudes[]
  enseignants     EnseignantDepartement[]
  snapshots       Snapshot[]
  validationRepartitions ValidationRepartition[] // état de validation par département (TAKT-L05-05)

  @@index([code])
  @@index([etablissementId])
}

// ----------------------------------------------------------------------------
// 5. Parcours — Référentiel des parcours de formation
// ----------------------------------------------------------------------------
model Parcours {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  departementId String   @db.Uuid
  originId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  departement Departement @relation(fields: [departementId], references: [id])
  niveaux     Niveau[]
  planEtudes  PlanEtudes[]

  @@index([code])
  @@index([departementId])
  @@unique([originId])
}

// ----------------------------------------------------------------------------
// 6. Niveau — Référentiel des niveaux (Licence, Master, etc.)
// ----------------------------------------------------------------------------
model Niveau {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  libelle   String
  parcoursId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parcours  Parcours @relation(fields: [parcoursId], references: [id])
  groupes   Groupe[]
  planEtudes PlanEtudes[]

  @@index([code])
  @@index([parcoursId])
}

// ----------------------------------------------------------------------------
// 10. Groupe — dépréciation du lien direct avec le plan d'études
// ----------------------------------------------------------------------------
// Un groupe hérite du plan d'études de son niveau (Groupe → Niveau → PlanEtudes).
// Aucune FK directe Groupe.planEtudesId n'est créée (TAKT-L05-01, héritage par niveau).

// ----------------------------------------------------------------------------
// 7. Groupe — Référentiel des groupes d'étudiants
// ----------------------------------------------------------------------------
model Groupe {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  libelle   String
  niveauId  String   @db.Uuid
  originId  String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  niveau    Niveau @relation(fields: [niveauId], references: [id])
  affectations AffectationPedagogique[]

  @@index([code])
  @@index([niveauId])
  @@unique([originId])
}

// ----------------------------------------------------------------------------
// 8. PlanEtudes — Plan d'études d'un niveau pour une année et un semestre
// ----------------------------------------------------------------------------
model PlanEtudes {
  id                 String   @id @default(uuid()) @db.Uuid
  parcoursId         String   @db.Uuid
  niveauId           String   @db.Uuid
  anneeUniversitaireId String @db.Uuid
  semestreId         String   @db.Uuid
  departementId      String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parcours             Parcours             @relation(fields: [parcoursId], references: [id])
  niveau               Niveau               @relation(fields: [niveauId], references: [id])
  anneeUniversitaire   AnneeUniversitaire   @relation(fields: [anneeUniversitaireId], references: [id])
  semestre             Semestre             @relation(fields: [semestreId], references: [id])
  departement          Departement          @relation(fields: [departementId], references: [id])
  planEtudesMatieres   PlanEtudesMatiere[]

  @@index([parcoursId])
  @@index([niveauId])
  @@index([anneeUniversitaireId])
  @@index([semestreId])
  @@index([departementId])
  @@unique([niveauId, anneeUniversitaireId, semestreId])
}

// ----------------------------------------------------------------------------
// 9. PlanEtudesMatiere — Matière d'un plan d'études avec volume horaire
// ----------------------------------------------------------------------------
model PlanEtudesMatiere {
  id               String   @id @default(uuid()) @db.Uuid
  planEtudesId     String   @db.Uuid
  matiereId        String   @db.Uuid
  typeEnseignementId String @db.Uuid
  volumeHoraire    Int      // volume horaire hebdomadaire, strictement positif
  dureeCreneaux    Int      // durée d'un créneau en minutes, strictement positive
  coefficient      Int      // coefficient pédagogique, strictement positif
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  planEtudes       PlanEtudes       @relation(fields: [planEtudesId], references: [id])
  matiere          Matiere          @relation(fields: [matiereId], references: [id])
  typeEnseignement TypeEnseignement @relation(fields: [typeEnseignementId], references: [id])

  @@index([planEtudesId])
  @@index([matiereId])
  @@index([typeEnseignementId])
  @@unique([planEtudesId, matiereId])
}

// ----------------------------------------------------------------------------
// 8. AnneeUniversitaire — Années académiques
// ----------------------------------------------------------------------------
model AnneeUniversitaire {
  id        String   @id @default(uuid()) @db.Uuid
  libelle   String   @unique
  dateDebut DateTime
  dateFin   DateTime
  semestres Semestre[]
  planEtudes PlanEtudes[]

  @@index([libelle])
}

// ----------------------------------------------------------------------------
// 5. Semestre — Semestres (1 ou 2 par année)
// ----------------------------------------------------------------------------
model Semestre {
  id                String   @id @default(uuid()) @db.Uuid
  numero            Int      // 1 ou 2
  anneeUniversitaireId String @db.Uuid
  dateDebut         DateTime
  dateFin           DateTime
  anneeUniversitaire AnneeUniversitaire @relation(fields: [anneeUniversitaireId], references: [id])
  versions          Version[]
  affectations      AffectationPedagogique[]
  planEtudes         PlanEtudes[]

  @@index([anneeUniversitaireId])
  @@index([numero])
  @@unique([anneeUniversitaireId, numero])
}

// ----------------------------------------------------------------------------
// 6. Version — Version de planning pour un semestre (10 états)
// ----------------------------------------------------------------------------
model Version {
  id          String   @id @default(uuid()) @db.Uuid
  semestreId  String   @db.Uuid
  etat        String   // initial, rep_pedag, brouillon, generation, edition, valid_pedag, valid_dir, valide, publie, archive
  snapshotId  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semestre    Semestre          @relation(fields: [semestreId], references: [id])
  seances     Seance[]
  snapshots   Snapshot[]
  generations Generation[]
  exports     Export[]
  contraintes Contrainte[]
  affectations AffectationPedagogique[]
  validationRepartitions ValidationRepartition[] // état de validation par département (TAKT-L05-05)

  @@index([semestreId])
  @@index([etat])
}

// ----------------------------------------------------------------------------
// 7. Snapshot — Snapshot immuable des données d'une version
// ----------------------------------------------------------------------------
model Snapshot {
  id            String      @id @default(uuid()) @db.Uuid
  versionId     String      @db.Uuid
  departementId String?     @db.Uuid // snapshot de répartition : un par (versionId, departementId) ; snapshot de publication : NULL
  revision      Int         @default(1) // numéro de révision du snapshot (historique des revalidations)
  estCourant    Boolean     @default(true) // true = snapshot actuellement en vigueur pour le département
  donnees       Json        // données JSONB du snapshot
  hash          String      // hash d'intégrité du snapshot
  createdAt     DateTime    @default(now())

  version       Version       @relation(fields: [versionId], references: [id])
  departement   Departement?  @relation(fields: [departementId], references: [id])

  // Historique des revalidations ciblées par département.
  validationRepartitionsCourant  ValidationRepartition[] @relation("SnapshotCourant")
  validationRepartitionsPrecedent ValidationRepartition[] @relation("SnapshotPrecedent")

  @@index([versionId])
  @@index([versionId, departementId])
  @@index([departementId])
}

// ----------------------------------------------------------------------------
// 7b. ValidationRepartition — État de validation d’un département pour une version
// ----------------------------------------------------------------------------
model ValidationRepartition {
  id                        String   @id @default(uuid()) @db.Uuid
  versionId                 String   @db.Uuid
  departementId             String   @db.Uuid
  etat                      String   // EN_COURS | VALIDE | REVALIDATION_REQUISE | REJETE
  revision                  Int      @default(1)
  hashAffectations          String?  // hash des affectations validées (détection d’impact par département)
  snapshotCourantId         String?  @db.Uuid
  snapshotPrecedentId       String?  @db.Uuid
  motif                     String?
  revalidationDemandeeLe    DateTime?
  revalidationDemandeePar   String?  @db.Uuid
  valideLe                  DateTime?
  validePar                 String?  @db.Uuid
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  version        Version              @relation(fields: [versionId], references: [id])
  departement    Departement          @relation(fields: [departementId], references: [id])
  snapshotCourant    Snapshot?        @relation("SnapshotCourant", fields: [snapshotCourantId], references: [id])
  snapshotPrecedent  Snapshot?        @relation("SnapshotPrecedent", fields: [snapshotPrecedentId], references: [id])

  @@index([versionId])
  @@index([departementId])
  @@index([versionId, departementId])
}

// ----------------------------------------------------------------------------
// 8. AffectationPedagogique — Enseignant ↔ Matière ↔ Groupe, volume horaire
// ----------------------------------------------------------------------------
model AffectationPedagogique {
  id                 String   @id @default(uuid()) @db.Uuid
  versionId          String   @db.Uuid
  semestreId         String   @db.Uuid
  departementId      String   @db.Uuid
  enseignantId       String   @db.Uuid
  matiereId          String   @db.Uuid
  groupeId           String   @db.Uuid
  typeEnseignementId String?  @db.Uuid
  volumeHebdo        Int      // volume horaire hebdomadaire
  dureeCreneaux      Int?     // durée d'un créneau (minutes)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  version            Version              @relation(fields: [versionId], references: [id])
  semestre           Semestre             @relation(fields: [semestreId], references: [id])
  departement        Departement          @relation(fields: [departementId], references: [id])
  enseignant         Enseignant           @relation(fields: [enseignantId], references: [id])
  matiere            Matiere              @relation(fields: [matiereId], references: [id])
  groupe             Groupe               @relation(fields: [groupeId], references: [id])
  typeEnseignement   TypeEnseignement?    @relation(fields: [typeEnseignementId], references: [id])

  @@unique([versionId, enseignantId, matiereId, groupeId])
  @@index([versionId])
  @@index([semestreId])
  @@index([departementId])
  @@index([enseignantId])
  @@index([matiereId])
  @@index([groupeId])
  @@index([typeEnseignementId])
}

// ----------------------------------------------------------------------------
// 9. Seance — Séance de cours (créneau récurrent)
// ----------------------------------------------------------------------------
model Seance {
  id             String   @id @default(uuid()) @db.Uuid
  versionId      String   @db.Uuid
  jour           Int      // 1=lundi … 6=samedi
  creneauDebut   Int      // index du créneau (0-based par jour)
  nbCreneaux     Int      // nombre de créneaux consécutifs
  salleId        String?  @db.Uuid
  enseignantId   String?  @db.Uuid
  groupeId       String?  @db.Uuid
  activiteId     String?  @db.Uuid
  estVerrouillee Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  version   Version     @relation(fields: [versionId], references: [id])
  verrous   VerrouSeance[]

  @@index([versionId])
  @@index([versionId, jour])
  @@unique([versionId, jour, creneauDebut, nbCreneaux])
}

// ----------------------------------------------------------------------------
// 10. VerrouSeance — Verrou sur une séance (créneau, salle, enseignant, activité)
// ----------------------------------------------------------------------------
model VerrouSeance {
  id             String   @id @default(uuid()) @db.Uuid
  seanceId       String   @db.Uuid
  utilisateurId  String   @db.Uuid
  type           String   // CRENEAU, SALLE, ENSEIGNANT, ACTIVITE
  heurePose      DateTime @default(now())
  heureExpiration DateTime // +30 min par défaut

  seance     Seance      @relation(fields: [seanceId], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([seanceId])
  @@index([utilisateurId])
  @@index([heureExpiration])
}

// ----------------------------------------------------------------------------
// 11. Contrainte — Contrainte de planification (indisponibilité, exigence salle)
// ----------------------------------------------------------------------------
model Contrainte {
  id        String   @id @default(uuid()) @db.Uuid
  versionId String   @db.Uuid
  type      String   // ex: INDISPONIBILITE, EXIGENCE_SALLE, CONTRAINTE_ENSEIGNANT
  cibleId   String   // identifiant de la cible (enseignant, salle, groupe, etc.)
  valeur    String   // valeur de la contrainte (JSON ou texte selon le type)
  createdAt DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id])

  @@index([versionId])
  @@index([type])
}

// ----------------------------------------------------------------------------
// 12. Generation — Job de génération CP-SAT
// ----------------------------------------------------------------------------
model Generation {
  id              String   @id @default(uuid()) @db.Uuid
  versionId       String   @db.Uuid
  statut          String   // EN_COURS, TERMINEE, ECHEC
  fichierDerivesId String? @db.Uuid
  scores          Json     // score_global, sous_scores
  createdAt       DateTime @default(now())

  version   Version   @relation(fields: [versionId], references: [id])
  scenarios Scenario[]

  @@index([versionId])
  @@index([statut])
}

// ----------------------------------------------------------------------------
// 13. Scenario — Scénario produit par le solver
// ----------------------------------------------------------------------------
model Scenario {
  id            String  @id @default(uuid()) @db.Uuid
  generationId  String  @db.Uuid
  scoreGlobal   Int     // score global 0-100
  sousScores    Json    // sous-scores détaillés (respect créneaux, salles, enseignants, couverture)
  selectionne   Boolean @default(false)
  createdAt     DateTime @default(now())

  generation Generation @relation(fields: [generationId], references: [id])

  @@index([generationId])
  @@index([selectionne])
}

// ----------------------------------------------------------------------------
// 14. Export — Fichier d'export généré
// ----------------------------------------------------------------------------
model Export {
  id             String   @id @default(uuid()) @db.Uuid
  versionId      String   @db.Uuid
  format         String   // xlsx, pdf, ics
  cheminFichier  String   // chemin vers le fichier généré
  dateGeneration DateTime @default(now())

  version Version @relation(fields: [versionId], references: [id])

  @@index([versionId])
  @@index([format])
}

// ----------------------------------------------------------------------------
// 15. JournalAudit — Journal d'audit (immuable)
// ----------------------------------------------------------------------------
model JournalAudit {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   // ex: VERSION_TRANSITION, SEANCE_DEPLACEE, VERROU_POSE, EXPORT_GENERE
  horodatage  DateTime @default(now())
  utilisateurId String? @db.Uuid
  entite      String   // ex: Version, Seance, Export
  entiteId    String?
  metadonnees Json?    // métadonnées optionnelles (motif de rejet, etc.)

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([horodatage])
  @@index([action])
  @@index([utilisateurId])
}

// ----------------------------------------------------------------------------
// 16. SessionRefresh — Famille de jetons de rafraîchissement (rotation)
// ----------------------------------------------------------------------------
model SessionRefresh {
  id            String   @id @default(uuid()) @db.Uuid
  jti           String   @unique @db.Uuid
  familyId      String   @db.Uuid
  utilisateurId String   @db.Uuid
  estRevoque    Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([jti])
  @@index([familyId])
  @@index([utilisateurId])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// 17. TypeEnseignement — Type d'enseignement (CM, TD, TP, PROJET)
// ----------------------------------------------------------------------------
model TypeEnseignement {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  couleur     String   // code hexadécimal #RRGGBB pour l'affichage dans la grille EDT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
  gradeType   GradeTypeEnseignement[]
  planEtudesMatieres PlanEtudesMatiere[]
  affectations AffectationPedagogique[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 18. Grade — Niveau/grade académique (L1, L2, L3, M1, M2)
// ----------------------------------------------------------------------------
model Grade {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  modules     Module[]
  gradeType   GradeTypeEnseignement[]
  enseignants Enseignant[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 19. GradeTypeEnseignement — Matrice type × grade (couples autorisés)
// ----------------------------------------------------------------------------
model GradeTypeEnseignement {
  id                 String   @id @default(uuid()) @db.Uuid
  gradeId            String   @db.Uuid
  typeEnseignementId String   @db.Uuid
  createdAt          DateTime @default(now())

  grade              Grade              @relation(fields: [gradeId], references: [id])
  typeEnseignement   TypeEnseignement   @relation(fields: [typeEnseignementId], references: [id])

  @@unique([gradeId, typeEnseignementId])
  @@index([gradeId])
  @@index([typeEnseignementId])
}

// ----------------------------------------------------------------------------
// 20. Module — Module pédagogique (lié à un type et un grade)
// ----------------------------------------------------------------------------
model Module {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  libelle         String
  typeEnseignementId String @db.Uuid
  gradeId         String   @db.Uuid
  originId        String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  typeEnseignement TypeEnseignement @relation(fields: [typeEnseignementId], references: [id])
  grade           Grade           @relation(fields: [gradeId], references: [id])
  matieres        Matiere[]

  @@index([code])
  @@index([typeEnseignementId])
  @@index([gradeId])
  @@unique([originId])
}

// ----------------------------------------------------------------------------
// 21. Matiere — Matière (liée à un module)
// ----------------------------------------------------------------------------
model Matiere {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  moduleId    String   @db.Uuid
  originId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  module      Module   @relation(fields: [moduleId], references: [id])
  planEtudesMatieres PlanEtudesMatiere[]
  affectations  AffectationPedagogique[]

  @@index([code])
  @@index([moduleId])
  @@unique([originId])
}

// ----------------------------------------------------------------------------
// 22. Enseignant — Référentiel des enseignants (L04-03)
// ----------------------------------------------------------------------------
model Enseignant {
  id          String   @id @default(uuid()) @db.Uuid
  matricule   String   @unique
  nom         String
  prenom      String
  email       String   @unique
  gradeId     String?  @db.Uuid
  estActif    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grade         Grade?                 @relation(fields: [gradeId], references: [id])
  departements  EnseignantDepartement[]
  affectations  AffectationPedagogique[]

  @@index([matricule])
  @@index([email])
  @@index([gradeId])
  @@index([nom])
  @@index([prenom])
}

// ----------------------------------------------------------------------------
// 23. EnseignantDepartement — Table associative N:N Enseignant ↔ Département
// ----------------------------------------------------------------------------
model EnseignantDepartement {
  enseignantId  String   @db.Uuid
  departementId String   @db.Uuid
  createdAt     DateTime @default(now())

  enseignant    Enseignant @relation(fields: [enseignantId], references: [id])
  departement   Departement @relation(fields: [departementId], references: [id])

  @@id([enseignantId, departementId])
  @@index([enseignantId])
  @@index([departementId])
}

// ----------------------------------------------------------------------------
// 22 (bis). ChargeRuleSet — Règles de charge horaire (complétée en L05-03)
// ----------------------------------------------------------------------------
model ChargeRuleSet {
  id                       String   @id @default(uuid()) @db.Uuid
  code                     String
  libelle                  String
  version                  Int      @default(1)
  estActive                Boolean  @default(false)
  seuilAlerte              Int      @default(90)
  plafondHebdomadaire      Int      @default(20)
  arrondi                  String   @default("UNITAIRE") // UNITAIRE | DEMI_JOURNEE | JOURNEE
  dureeJournee             Float    @default(7)
  dureeDemiJournee         Float    @default(3.5)
  coefficientsParType      Json     // { [typeCode: string]: number }
  cibleHebdomadaireParGrade Json    // { [gradeCode: string]: number }
  toleranceEquilibrage     Float    @default(5)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([code, version])
  @@index([code])
  @@index([estActive])
}

// ----------------------------------------------------------------------------
// 23. Site — Site physique hébergeant des salles (L04-04)
// ----------------------------------------------------------------------------
model Site {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salles      Salle[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 24. TypeSalle — Type de salle (amphithéâtre, cours, TP, informatique…)
// ----------------------------------------------------------------------------
model TypeSalle {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  libelle     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  salles      Salle[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 25. Equipement — Équipement installable dans une salle
// ----------------------------------------------------------------------------
model Equipement {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  libelle        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  salleEquipements SalleEquipement[]

  @@index([code])
}

// ----------------------------------------------------------------------------
// 26. Salle — Salle transverse (aucun departementId, EX-REF-03)
// ----------------------------------------------------------------------------
model Salle {
  id           String      @id @default(uuid()) @db.Uuid
  code         String      @unique
  libelle      String
  typeSalleId  String      @db.Uuid
  capacite     Int
  siteId       String      @db.Uuid
  originId     String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  typeSalle       TypeSalle       @relation(fields: [typeSalleId], references: [id])
  site            Site            @relation(fields: [siteId], references: [id])
  salleEquipements SalleEquipement[]

  @@index([code])
  @@index([typeSalleId])
  @@index([siteId])
  @@index([capacite])
  @@unique([originId])
}

// ----------------------------------------------------------------------------
// 27. SalleEquipement — Association N:N Salle ↔ Equipement avec quantité
// ----------------------------------------------------------------------------
model SalleEquipement {
  salleId       String   @db.Uuid
  equipementId  String   @db.Uuid
  quantite      Int      @default(1)
  createdAt     DateTime @default(now())

  salle     Salle     @relation(fields: [salleId], references: [id])
  equipement Equipement @relation(fields: [equipementId], references: [id])

  @@id([salleId, equipementId])
  @@index([salleId])
  @@index([equipementId])
}

// ----------------------------------------------------------------------------
// 28. Creneau — Créneau horaire de la grille (L04-05)
// ----------------------------------------------------------------------------
model Creneau {
  id           String   @id @default(uuid()) @db.Uuid
  jour         Int      // 1..6 (lun–sam)
  ordre        Int      // consécutif et unique par jour
  heureDebut   DateTime
  heureFin     DateTime
  dureeMinutes Int      @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([jour, ordre])
  @@index([jour])
}

// ----------------------------------------------------------------------------
// 29. CreneauAffichage — Variante d'affichage (NORMAL / RAMADAN) (L04-05)
// ----------------------------------------------------------------------------
model CreneauAffichage {
  id                String   @id @default(uuid()) @db.Uuid
  variante          String   @unique // NORMAL | RAMADAN
  decalageMinutes   Int      @default(0)
  plageReduiteMinutes Int?   // réduction de la plage horaire (Ramadan)
  libelle           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// 30. ConfigSysteme — Paramètres système (singleton) (L04-05)
// ----------------------------------------------------------------------------
model ConfigSysteme {
  id                String   @id @default(uuid()) @db.Uuid
  pasDeTempsMinutes Int      @default(30)
  joursOuvres       String   // ex: "1,2,3,4,5,6"
  creneauxParJour   Int      @default(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// 31. Notification — Notification in-app émise à un utilisateur (TAKT-L05-05)
// ----------------------------------------------------------------------------
model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  utilisateurId String   @db.Uuid
  type          String   // REVALIDATION_DEMANDEE | REVALIDATION_VALIDEE | ...
  titre         String
  message       String
  lue           Boolean  @default(false)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([utilisateurId, lue])
}