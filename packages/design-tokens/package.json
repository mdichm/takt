{
  "name": "@takt/design-tokens",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens-normal.css": "./tokens-normal.css",
    "./tokens-ramadan.css": "./tokens-ramadan.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "generate": "node dist/generer-cli.js",
    "test": "vitest run --passWithNoTests",
    "test:tokens": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  }
}
